# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — leave unset to fall back to local sqlite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rayalseema

# Redis (cache, Channels, Celery)
REDIS_URL=redis://127.0.0.1:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# OTP — True uses console/log stubs instead of real Twilio/SMTP calls
OTP_STUB_MODE=True
OTP_TTL_MINUTES=10

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (SMTP) — EMAIL_BACKEND defaults to console output when unset
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@rayalseema.local

# Razorpay — PAYMENT_STUB_MODE=True skips real Razorpay calls and simulates success
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_STUB_MODE=True

# Checkout
DELIVERY_FLAT_FEE=30.0
DELIVERY_PARTNER_EARNING_PER_ORDER=25.0

# Firebase (push notifications)
FIREBASE_CREDENTIALS_JSON=

# Google Maps / OAuth
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AWS S3 (media) — set USE_S3=True to enable
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
